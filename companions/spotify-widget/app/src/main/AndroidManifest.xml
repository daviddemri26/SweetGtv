<?xml version="1.0" encoding="utf-8"?>
<!-- Invoked by Home's explicit shortcut: a second app-library tile is deliberately absent. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingLeanbackLauncher">
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <permission
        android:name="com.daviddemri.tv.spotify.permission.READ_PLAYBACK_TITLE"
        android:protectionLevel="signature" />
    <queries>
        <package android:name="com.spotify.tv.android" />
        <package android:name="com.gathin.tvhome" />
    </queries>
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_music_note"
        android:label="@string/app_name"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:theme="@style/SpotifyWidgetTheme">
        <provider
            android:name=".SpotifySetupProvider"
            android:authorities="com.daviddemri.tv.spotify.setup"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS"
            android:grantUriPermissions="false" />
        <!-- The signed Home binds while visible; the read-only stream stops at unbind. -->
        <service
            android:name=".SpotifyHomeService"
            android:exported="true"
            android:permission="com.daviddemri.tv.spotify.permission.READ_PLAYBACK_TITLE" />
        <!-- A translucent Activity must not request screenOrientation on Android 8.0. -->
        <activity
            android:name=".SpotifyWidgetActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="com.daviddemri.tv.spotify.OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
